{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zju-research-skills.local/schemas/research-document-source.schema.json",
  "title": "Source-grounded research document input",
  "type": "object",
  "required": ["document_id", "title", "sections", "sources"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "level"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "level": {"enum": [1, 2, 3]},
          "paragraphs": {"type": "array", "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/textRecord"}]}},
          "bullets": {"type": "array", "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/textRecord"}]}}
        }
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRecord"}}
  },
  "$defs": {
    "textRecord": {"type": "object", "required": ["text", "source_ids"], "properties": {"text": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "sourceRecord": {"type": "object", "required": ["source_id", "citation", "anchor"], "properties": {"source_id": {"type": "string", "minLength": 1}, "citation": {"type": "string", "minLength": 1}, "anchor": {"type": "string", "minLength": 1}}}
  }
}
