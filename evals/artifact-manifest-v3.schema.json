{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-manifest-v3.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "layer", "artifacts", "artifact_manifest_sha256"],
  "properties": {
    "schema_version": {"const": "3.0"}, "run_id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["L3_controlled_task_capability", "L4_frozen_holdout_generalization"]},
    "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "skill_id", "case_id", "blind_label", "artifact_role", "artifact_path", "artifact_sha256", "artifact_size_bytes"],
        "properties": {
          "layer": {"enum": ["L3_controlled_task_capability", "L4_frozen_holdout_generalization"]},
          "skill_id": {"type": "string"}, "case_id": {"type": "string"},
          "blind_label": {"type": ["string", "null"], "enum": ["A", "B", "C", null]},
          "artifact_role": {"enum": ["fixture", "generated_artifact", "execution_trace"]},
          "artifact_path": {"type": "string"}, "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "artifact_size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
