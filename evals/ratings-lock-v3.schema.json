{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ratings-lock-v3.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "layer", "sealed_at", "sealed_before_reveal", "response_manifest_sha256", "rating_entry_count", "adjudication_entry_count", "raw_ratings_adjudication_sha256", "ratings_lock_sha256"],
  "properties": {
    "schema_version": {"const": "3.0"}, "run_id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["L3_controlled_task_capability", "L4_frozen_holdout_generalization"]},
    "sealed_at": {"type": "string", "format": "date-time"}, "sealed_before_reveal": {"const": true},
    "response_manifest_sha256": {"$ref": "#/$defs/sha256"}, "rating_entry_count": {"type": "integer", "minimum": 2},
    "adjudication_entry_count": {"type": "integer", "minimum": 0}, "raw_ratings_adjudication_sha256": {"$ref": "#/$defs/sha256"},
    "ratings_lock_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
