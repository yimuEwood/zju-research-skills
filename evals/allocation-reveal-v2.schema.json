{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yimuEwood/zju-research-skills/evals/allocation-reveal-v2.schema.json",
  "title": "Post-rating allocation reveal for protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "freeze_id",
    "secret",
    "nonce",
    "commitment_sha256",
    "ratings_bundle_sha256",
    "revealed_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "freeze_id": {"type": "string", "minLength": 1},
    "secret": {"type": "string", "minLength": 32},
    "nonce": {"type": "string", "minLength": 16},
    "commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ratings_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revealed_at": {"type": "string", "format": "date-time"}
  }
}
