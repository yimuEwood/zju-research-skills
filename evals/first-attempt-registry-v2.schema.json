{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yimuEwood/zju-research-skills/evals/first-attempt-registry-v2.schema.json",
  "title": "Immutable first-attempt reservation for a protocol v2 holdout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "freeze_id",
    "genesis_sha256",
    "registered_at",
    "attempts"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "freeze_id": {"type": "string", "minLength": 1},
    "genesis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registered_at": {"type": "string", "format": "date-time"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_number", "run_id", "case_ids", "case_fingerprints"],
        "properties": {
          "attempt_number": {"const": 1},
          "run_id": {"type": "string", "minLength": 1},
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "case_fingerprints": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
