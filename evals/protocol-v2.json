      "LIT-06",
      "FULL-06",
      "REF-06",
      "READ-05",
      "LOG-06",
      "STAT-01",
      "WRITE-03"
    ],
    "known_case_sources": [
      {
        "kind": "case_file",
        "path": "evals/cases.json",
        "reason": "All 70 v1 cases are public and were used during project development or evaluation."
      }
    ]
  },
  "allocation": {
    "method": "committed_secret_skill_blocked_latin_square",
    "commitment_scheme": "sha256-v1",
