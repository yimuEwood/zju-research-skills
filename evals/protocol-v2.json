    "distilled_skill"
  ],
  "expected_skills": [
    "zju-literature-search",
    "zju-fulltext-access",
    "zju-reference-audit",
    "zju-paper-reader",
    "zju-experiment-log",
    "zju-statistics-audit",
    "zju-scientific-writing"
  ],
  "dataset": {
    "development_cases_path": "evals/cases.json",
    "frozen_holdout_cases_path": null,
