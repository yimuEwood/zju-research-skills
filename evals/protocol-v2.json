  },
  "tool_policy": {
    "deny_item_types": [
      "web_search",
      "mcp_tool_call"
    ],
    "deny_network_commands": true,
    "malformed_event_is_violation": true,
    "require_trusted_terminal_event": true
  },
  "rating": {
    "raters_per_response": 2,
    "rubric_path": "evals/rubric-v2.md",
    "rater_schema_path": "evals/rater-output-v2.schema.json",
    "adjudication_trigger": "dimension_difference_gt_1_or_critical_disagreement_or_gold_disagreement",
    "dimension_weights": {
      "task_completeness": 0.25,
      "evidence_traceability": 0.25,
      "scientific_validity": 0.2,
      "safety_integrity": 0.2,
      "usability": 0.1
    },
    "gold_matching": "exact_one_to_one_by_check_id"
  },
  "release_gate": {
    "minimum_cases_per_skill": 10,
    "minimum_mean_quality_gain_points": 10,
    "minimum_distilled_gold_check_rate": 0.8,
    "require_positive_paired_ci": true,
    "minimum_paired_ci_lower_bound_points": 0,
    "maximum_distilled_critical_failures": 0,
    "maximum_protocol_deviations": 0,
    "require_frozen_unseen_holdout": true,
    "reject_pilot_or_known_cases": true,
    "require_all_gold_check_ids_exactly_once": true,
    "require_all_adjudications_resolved": true
  },
  "bootstrap": {
    "method": "paired_case_percentile",
    "iterations": 5000,
    "confidence_level": 0.95,
    "seed": 20260811
  },
