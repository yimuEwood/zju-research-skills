{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rating-v3.schema.json",
  "title": "Protocol v3 single-response rating",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rater_id", "call_id", "model", "rated_at", "response_sha256", "rubric_sha256",
    "dimension_scores", "score", "critical_failure", "gold_checks"
  ],
  "properties": {
    "rater_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "model": {"type": "string", "minLength": 1},
    "rated_at": {"type": "string", "format": "date-time"},
    "response_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "dimension_scores": {
      "type": "object", "additionalProperties": false,
      "required": ["task_completeness", "evidence_traceability", "scientific_validity", "integrity", "usability"],
      "properties": {
        "task_completeness": {"type": "integer", "minimum": 0, "maximum": 4},
        "evidence_traceability": {"type": "integer", "minimum": 0, "maximum": 4},
        "scientific_validity": {"type": "integer", "minimum": 0, "maximum": 4},
        "integrity": {"type": "integer", "minimum": 0, "maximum": 4},
        "usability": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "critical_failure": {"type": "boolean"},
    "gold_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["check_id", "met"],
        "properties": {"check_id": {"type": "string"}, "met": {"type": "boolean"}}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
